@page "/requests"

<PageTitle>Riepilogo richieste Telegram</PageTitle>

<h1>Riepilogo richieste Telegram</h1>

<p class="text-muted">
    La pagina legge e cancella la memoria tramite REST API. La memoria è limitata dal valore
    <code>RequestMemory:MaxEntries</code> in appsettings.
</p>

<section class="telegram-history" data-telegram-history data-api-url="/api/telegram/requests">
    <div class="row g-3 align-items-end">
        <div class="col-sm-3">
            <label class="form-label" for="history-take">Ultime N richieste</label>
            <input class="form-control" id="history-take" data-history-take type="number" min="1" value="20" />
        </div>
        <div class="col-sm-5">
            <label class="form-label" for="history-caller">Caller opzionale</label>
            <input class="form-control" id="history-caller" data-history-caller maxlength="120" placeholder="Lascia vuoto per tutti" />
        </div>
        <div class="col-sm-4 d-flex gap-2">
            <button class="btn btn-primary" type="button" data-history-refresh>Aggiorna</button>
            <button class="btn btn-outline-danger" type="button" data-history-clear>Svuota memoria</button>
        </div>
    </div>

    <div class="telegram-status mt-3" role="status" aria-live="polite" data-history-status></div>
    <div class="mt-3" data-history-summary></div>
    <div class="mt-3" data-history-groups></div>
</section>
